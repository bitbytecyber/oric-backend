# Template: copy to `.env` beside the compose file and fill in.
# Used by `docker compose -f docker-compose.local.yml` (and dev/prod on servers).

COMPOSE_PROJECT_NAME=oric_local
DEBUG=1
SECRET_KEY=local-dev-change-me
DJANGO_SETTINGS_MODULE=oric_backend.settings.dev
SERVE_API_DOCS=1

DATABASE_NAME=oric-local
DATABASE_USER=oric
DATABASE_PASSWORD=oric-local-pass
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_PORT_HOST=5442

# Web app (npm run dev in ../frontend). Must match its origin for CORS + email links.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email: Mailpit locally (http://localhost:8035)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=ORIC NED <oric@neduet.edu.pk>

# Google sign-in (optional; keys not set = button hidden)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=

# Apple sign-in (optional; needs a live HTTPS Return URL)
APPLE_OAUTH_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Demo seed password (python manage.py seed_oric --demo)
ORIC_DEMO_PASSWORD=OricDemo#2026

# --- server-only (dev/prod) ---
ALLOWED_HOSTS=
ALLAUTH_TRUSTED_PROXY_COUNT=0
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
